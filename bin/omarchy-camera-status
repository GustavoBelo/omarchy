#!/bin/bash

# omarchy:summary=Print camera state as JSON, or stream it with --watch
# omarchy:args=[--watch]
# omarchy:hidden=true

set -euo pipefail

DISABLED_FLAG="${OMARCHY_CAMERA_DISABLED_FLAG:-/var/lib/omarchy/camera-disabled}"
USB_DEVICES="${OMARCHY_USB_DEVICES_PATH:-/sys/bus/usb/devices}"

# Disabled cameras still count, so the bar keeps a way to turn them back on.
cameras_present() {
  local interface

  for interface in "$USB_DEVICES"/*:*; do
    [[ -r $interface/bInterfaceClass ]] || continue
    if [[ $(<"$interface/bInterfaceClass") == "0e" ]]; then
      return 0
    fi
  done

  return 1
}

camera_users() {
  local fd comm via_pipewire=0

  # A single find, because resolving every fd link from bash takes seconds.
  # Other users' fd tables are unreadable, so find always exits non-zero, and
  # an app still holding a camera that was just disabled points at a deleted
  # node that no longer captures.
  while IFS= read -r fd; do
    comm=$(cat "${fd%/fd/*}/comm" 2>/dev/null) || continue
    if [[ $comm == "pipewire" || $comm == "wireplumber" ]]; then
      via_pipewire=1
    else
      echo "$comm"
    fi
  done < <(find /proc/[0-9]*/fd -mindepth 1 -maxdepth 1 \
    -lname '/dev/video*' ! -lname '* (deleted)' 2>/dev/null || true)

  if (( via_pipewire )); then
    pipewire_camera_users
  fi
}

# PipeWire opens every camera for a moment when it shows up, and also holds it
# for apps that capture through the camera portal. Only a running video source
# means an app is actually getting frames.
pipewire_camera_users() {
  pw-dump 2>/dev/null | jq -r '
    (map(select(.type == "PipeWire:Interface:Client") | {key: (.id | tostring), value: .info.props}) | from_entries) as $clients
    | [.[] | select(.type == "PipeWire:Interface:Node" and .info.state == "running") | .info.props] as $running
    | if any($running[]; ."media.class" == "Video/Source") then
        ([$running[] | select(."media.class" == "Stream/Input/Video")
          | $clients[(."client.id" // "" | tostring)] as $client
          | ."application.name" // $client."application.name" // ."node.name" // empty]
          | if length > 0 then .[] else "PipeWire" end)
      else empty end
  ' || true
}

json_bool() {
  if "$@"; then
    echo true
  else
    echo false
  fi
}

status() {
  local present disabled apps

  present=$(json_bool cameras_present)
  disabled=$(json_bool test -e "$DISABLED_FLAG")
  apps=$(camera_users | sort -u | jq -Rsc 'split("\n") | map(select(length > 0))')

  jq -nc \
    --argjson present "$present" \
    --argjson disabled "$disabled" \
    --argjson apps "$apps" \
    '{present: $present, disabled: $disabled, inUse: ($apps | length > 0), apps: $apps}'
}

regex_escape() {
  sed 's/[][\.^$*+?(){}|/]/\\&/g' <<<"$1"
}

watch() {
  local current previous="" flag_dir watch_dir waiter_dir="" relevant waiter_fd="" waiter_pid="" waited

  flag_dir=$(dirname "$DISABLED_FLAG")
  relevant="^(/dev/video[0-9]+|$(regex_escape "$flag_dir")|$(regex_escape "$DISABLED_FLAG"))\$"

  while true; do
    # The flag's directory only appears on the first disable, so until then
    # watch the closest one that exists for its creation.
    watch_dir=$flag_dir
    while [[ ! -d $watch_dir ]]; do
      watch_dir=$(dirname "$watch_dir")
    done

    # Started before the scan, so an event landing mid-scan waits in the pipe
    # instead of leaving the bar stale.
    if [[ -z $waiter_fd || $watch_dir != "$waiter_dir" ]]; then
      if [[ -n $waiter_fd ]]; then
        kill "$waiter_pid" 2>/dev/null || true
        exec {waiter_fd}<&-
      fi
      # /dev/null alone is opened several times a second, and a watch on /dev
      # reports it. pdeathsig keeps the waiter from outliving the shell.
      exec {waiter_fd}< <(exec setpriv --pdeathsig TERM inotifywait -m -q \
        -e open,close,create,delete --include "$relevant" \
        /dev "$watch_dir" 2>/dev/null)
      waiter_pid=$!
      waiter_dir=$watch_dir
    fi

    current=$(status)
    if [[ $current != "$previous" ]]; then
      echo "$current"
      previous=$current
    fi

    # The timeout only bounds how stale a missed event can leave the bar.
    waited=0
    read -r -t 30 -u "$waiter_fd" _ || waited=$?

    if (( waited == 0 )); then
      # Opening a camera comes as a burst of events; one scan covers them all.
      while read -r -t 0.1 -u "$waiter_fd" _; do :; done
    elif (( waited <= 128 )); then
      # A watch that cannot be set up ends at once; back off and set it up
      # again instead of rescanning in a tight loop.
      exec {waiter_fd}<&-
      waiter_fd=""
      sleep 5
    fi
  done
}

case "${1:-}" in
  "")
    status
    ;;
  --watch)
    watch
    ;;
  *)
    echo "Usage: omarchy-camera-status [--watch]" >&2
    exit 1
    ;;
esac
